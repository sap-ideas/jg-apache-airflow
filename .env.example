# Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored — NEVER commit real credentials.

# Airflow User ID (don't change unless permission issues)
AIRFLOW_UID=50000

# Airflow Web UI Credentials — change the password, don't ship with a default
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=

# Project Directory
AIRFLOW_PROJ_DIR=.

# Airflow Fernet key (encrypts Variables/Connections at rest)
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be IDENTICAL across every Airflow component. Keep the same key across
# restarts/redeploys or existing encrypted Variables/Connections become unreadable.
AIRFLOW__CORE__FERNET_KEY=

# iSeller Pusat API Token (expires periodically — update manually, or set as an
# Airflow Variable instead; see docs/AIRFLOW_SECRETS_AND_VARIABLES.md)
access_token_pusat=

# Power Automate Teams webhook (Adaptive Card)
POWER_AUTOMATE_TEAMS_WEBHOOK_URL=

# ============================================
# Database credentials
# ============================================

# MySQL Data Lake
DB_LAKE_HOST=
DB_LAKE_USER=
DB_LAKE_PASSWORD=
DB_LAKE_NAME=

# MySQL Data Warehouse
DB_WAREHOUSE_HOST=
DB_WAREHOUSE_USER=
DB_WAREHOUSE_PASSWORD=
DB_WAREHOUSE_NAME=

# KSJ Link PostgreSQL
KSJ_LINK_HOST=
KSJ_LINK_HOST_LOCATION=
KSJ_LINK_USER=
KSJ_LINK_PASSWORD=
KSJ_LINK_PORT=5432
KSJ_LINK_DB_TRANSACTION=d_transaction
KSJ_LINK_DB_LOCATION=d_location
KSJ_LINK_DB_PAYMENT=d_payment
KSJ_LINK_DB_RIDER=d_rider
KSJ_LINK_DB_CMS=d_cms
KSJ_LINK_DB_JIWA_KSJ=jiwa-ksj

# JiwaPlus (consumer app) PostgreSQL
JIWAPLUS_HOST=
JIWAPLUS_DATABASE=
JIWAPLUS_USER=
JIWAPLUS_PASSWORD=
JIWAPLUS_PORT=5432

# Gmail SMTP app password for DAG email notifications (sender:
# saputra.christabel20@gmail.com). Generate at Google Account > Security > App passwords.
GMAIL_SMTP_PASSWORD=

# Optional: override the /etc/hosts entry docker-compose adds for dblake.jiwa.prod
# DBLAKE_EXTRA_HOST_IP=

# ============================================
# Landlord revenue-sharing API (Lippo Mall) — dags/api_integration_landlord
# Shared token endpoint, credentials per outlet (jilid). To add a new outlet:
# append its code to LANDLORD_OUTLET_CODES and add its own _EMAIL/_PASSWORD pair
# below — no code change needed (see extract.py :: get_access_token).
# ============================================
LANDLORD_TOKEN_API_URL=
LANDLORD_OUTLET_CODES=

# One pair per code listed in LANDLORD_OUTLET_CODES, e.g.:
# LANDLORD_OUTLET_01065_EMAIL=
# LANDLORD_OUTLET_01065_PASSWORD=
